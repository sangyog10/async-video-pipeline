      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "stacking": { "mode": "none" } }, "unit": "short" }, "overrides": [] }
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Redis Memory Used",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 32 },
      "targets": [
        { "refId": "A", "expr": "redis_memory_used_bytes", "legendFormat": "memory" }
      ],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "stacking": { "mode": "none" } }, "unit": "bytes" }, "overrides": [] }
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "MinIO Uptime",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 32 },
      "targets": [
        { "refId": "A", "expr": "minio_process_uptime_seconds", "legendFormat": "uptime" }
      ],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "stacking": { "mode": "none" } }, "unit": "s" }, "overrides": [] }
    }
