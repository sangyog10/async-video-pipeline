      "targets": [{ "refId": "A", "expr": "up{job=\"api-server\"}", "legendFormat": "up" }],
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null },
            { "color": "green", "value": 1 }
          ] },
          "mappings": [
            { "options": { "1": "UP", "0": "DOWN" }, "type": "value" }
          ]
        }
      },
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } }
